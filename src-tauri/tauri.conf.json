{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TidyUp",
  "version": "1.0.0",
  "identifier": "com.arpon.tidy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TidyUp",
        "width": 1000,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true
      },
      {
        "label": "toast",
        "url": "toast.html",
        "title": "TidyUp toast",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false,
        "width": 560,
        "height": 96
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Files your downloads into plainly named folders, automatically. Nothing is ever deleted.",
    "longDescription": "TidyUp watches your Downloads folder and quietly moves installers, pictures, videos, documents and more into folders you can read at a glance. Nothing is ever deleted and every move can be undone.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
